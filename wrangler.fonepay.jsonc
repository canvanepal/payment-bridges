{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fonepay-bridge",
  "main": "src/fonepay/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public-fonepay"
  },
  "observability": {
    "enabled": true
  },
  // Edge-wide sign-in throttle. Especially relevant here: renewal re-signs in
  // with the stored password, so a runaway login loop is a password-guessing
  // loop against the bank.
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "FONEPAY_API_BASE_URL": "https://corporate-kong.fonepay.com/corporate/api",
    "FONEPAY_AUTH_BASE_URL": "https://corporate-kong.fonepay.com/corporate/auth",
    "FONEPAY_ORIGIN": "https://fonebiz.fonepay.com",
    "FONEPAY_CLIENT_CODE": "CORPORATE_USER",
    "FONEPAY_RENEW_ON_EXPIRY": "1",
    "ALLOWED_ORIGINS": "",
    "LOGIN_RATE_LIMIT_PER_MINUTE": "10",
    "DEBUG_UPSTREAM": "0"
  }
}
