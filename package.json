{
  "name": "payment-bridges",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers that front the NepalPay merchant portal and the Fonepay corporate portal.",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "dev:fonepay": "wrangler dev --config wrangler.fonepay.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:fonepay": "wrangler deploy --config wrangler.fonepay.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:e2e:fonepay": "node test/e2e-fonepay.mjs",
    "test:all": "npm test && npm run test:e2e && npm run test:e2e:fonepay",
    "find-refresh": "node tools/find-refresh.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "esbuild": "^0.28.1",
    "qrcode-generator": "^2.0.4",
    "typescript": "^5.9.0",
    "wrangler": "^4.136.3"
  }
}
